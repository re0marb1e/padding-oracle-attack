{
  "name": "padding-oracle-attack",
  "version": "1.0.0",
  "description": "分组密码 CBC 填充提示攻击演示：无需密钥解读 aes-128-cbc 密文",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/re0marb1e/padding-oracle-attack.git"
  },
  "author": "re0marb1e",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/re0marb1e/padding-oracle-attack/issues"
  },
  "homepage": "https://github.com/re0marb1e/padding-oracle-attack#readme",
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.8",
    "husky": "^9.0.0",
    "lint-staged": "^17.0.0",
    "markdownlint-cli2": "^0.23.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": ["biome check --write --no-errors-on-unmatched"],
    "*.md": "markdownlint-cli2 --no-globs"
  }
}
